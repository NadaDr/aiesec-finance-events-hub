# ============================================================
# AIESEC FINANCE HUB — BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to version control.
# ============================================================

# Server Port (default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username> and <password> with your Atlas database user credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aiesec_finance_hub?retryWrites=true&w=majority

# JSON Web Token Secret Key for user authentication
JWT_SECRET=your_jwt_super_secret_key_here

# Frontend origin(s) allowed by CORS — comma-separated, no trailing slash.
# Include your deployed frontend, e.g. http://localhost:5173,https://your-app.vercel.app
# If left empty, every origin is allowed (development only).
CLIENT_URL=http://localhost:5173
